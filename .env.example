# 로컬 개발용 환경변수 예시입니다.
# 이 파일을 복사해 .env 를 만들고 실제 값을 채웁니다.
#   cp .env.example .env
# .env 는 커밋하지 않습니다. 실제 secret 은 여기 두지 않습니다.

# 실행 프로필
SPRING_PROFILES_ACTIVE=local

# 애플리케이션 포트
SERVER_PORT=8080

# 데이터베이스 (로컬은 docker-compose 의 pgvector PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/momens
DATABASE_USERNAME=momens
DATABASE_PASSWORD=momens

# docker-compose PostgreSQL 초기화 값
POSTGRES_DB=momens
POSTGRES_USER=momens
POSTGRES_PASSWORD=momens
POSTGRES_PORT=5432
